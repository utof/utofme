+      - name: check:privacy
+        run: bun run --cwd packages/site check:privacy
+
       # ── Loop media consistency (committed outputs ↔ src/data/loops.json; needs no ffmpeg) ──
       - name: check:media
         run: bun run --cwd packages/site check:media
@@ -101,6 +108,9 @@ jobs:
       - name: build
         run: bun run --cwd packages/site build
 
+      - name: check:privacy (dist)
+        run: bun run --cwd packages/site check:privacy --dist dist
+
       # ── Unit tests (depend on dist/ from the build step above) ─────────────────
       - name: test (vitest)
         run: bun run --cwd packages/site test
@@ -125,3 +135,34 @@ jobs:
       # Source: packages/specs/specs/00-foundations.md § "Success criteria" LHCI note.
       - name: Lighthouse CI
         run: cd packages/site && npx @lhci/cli autorun
+
+  # Why: builds exactly what deploy.yml ships (fixtures off) so a deploy-only failure shows on the PR (P10-3).
+  deploy-build:
+    runs-on: ubuntu-latest
+    env:
+      PRIVACY_DENYLIST: ${{ secrets.PRIVACY_DENYLIST }}
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: "1.3"
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22.23"
+
+      - name: Install dependencies
+        run: bun install --frozen-lockfile
+
+      - name: Build (deploy variant)
+        run: bun run --cwd packages/site build
+        env:
+          UTOFME_FIXTURES: "false"
+
+      - name: check:no-fixtures
+        run: bun run --cwd packages/site check:no-fixtures
+
+      - name: check:privacy (dist)
+        run: bun run --cwd packages/site check:privacy --dist dist
