{
	"plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
	"useTabs": true,
	"printWidth": 100,
	"singleQuote": false,
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
