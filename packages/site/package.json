{
	"name": "@utofme/site",
	"version": "0.0.0",
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/mdx": "^5",
		"@astrojs/react": "^5",
		"@astrojs/svelte": "^7",
		"@axe-core/playwright": "^4.11.2",
		"@biomejs/biome": "^2.4.13",
		"@codesandbox/sandpack-react": "2.20.0",
		"@fast-check/vitest": "^0.4",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.59.1",
		"@size-limit/file": "12.1.0",
		"@size-limit/preset-app": "12.1.0",
		"@stryker-mutator/core": "^9",
		"@stryker-mutator/typescript-checker": "^9",
		"@stryker-mutator/vitest-runner": "^9",
		"@types/bun": "1.3.13",
		"@types/node": "^25.6.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.5",
		"astro": "^6",
		"astro-expressive-code": "^0.41",
		"astro-pagefind": "^1.8.6",
		"dependency-cruiser": "^17.3.10",
		"fast-check": "^4",
		"happy-dom": "^20.9.0",
		"knip": "^6.6.3",
		"lefthook": "^2.1.6",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^3.5.1",
		"size-limit": "12.1.0",
		"svelte": "^5",
		"ts-morph": "^28.0.0",
		"type-coverage": "^2.29.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5",
		"wrangler": "^4.85.0"
	},
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"prebuild:stats": "bun run scripts/fetch-stats-snapshot.ts",
		"preview": "astro preview --host 127.0.0.1",
		"astro": "astro",
		"check:biome": "biome check .",
		"check:prettier": "prettier --check '**/*.{astro,svelte}'",
		"check:astro": "astro check",
		"check:type-coverage": "type-coverage --at-least 100 --strict",
		"check:knip": "knip",
		"check:depcruise": "depcruise --validate .dependency-cruiser.cjs src",
		"check:docs": "bun run scripts/check-docs.ts",
		"check:size": "size-limit",
		"check:lighthouse": "npx @lhci/cli autorun",
		"test": "vitest run",
		"test:unit": "vitest run --coverage",
		"test:e2e": "node node_modules/@playwright/test/cli.js test",
		"test:mutation": "stryker run"
	},
	"type": "module",
	"typeCoverage": {
		"atLeast": 100,
		"strict": true,
		"ignoreFiles": [
			".astro/**"
		]
	},
	"dependencies": {
		"react": "^19",
		"react-dom": "^19",
		"sharp": "^0.34.5"
	}
}
