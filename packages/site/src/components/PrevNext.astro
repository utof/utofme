---
/**
 * PrevNext.astro — text-only prev / all / next links at the foot of a project.
 *
 * Why: anatomy item 7. Text only (no media) so a link can never collide with a
 * persisted `loop-<slug>` id.
 *
 * @see packages/specs/specs/09-project-view.md § P9-8
 */
import { detailUrl } from "../lib/works";

export interface Props {
	prev: { id: string; title: string } | null;
	next: { id: string; title: string } | null;
}
const { prev, next } = Astro.props;
---

<nav class="prevnext" aria-label="More projects" data-test="prev-next">
	{prev ? (
		<a href={detailUrl(prev)} rel="prev" data-test="prev">
			← {prev.title}
		</a>
	) : (
		<span />
	)}
	<a href="/" data-test="all-projects">
		All projects
	</a>
	{next ? (
		<a href={detailUrl(next)} rel="next" data-test="next">
			{next.title} →
		</a>
	) : (
		<span />
	)}
</nav>

<style>
	.prevnext {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: var(--space-4);
		margin-block: var(--space-8) 0;
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
		font-size: var(--font-size-ui);
	}
	/* Why: three fixed slots (empty ones kept) so "All projects" stays centred and
	 * prev/next hug the edges when a neighbour is missing (P-07). */
	.prevnext a[rel="prev"] {
		justify-self: start;
	}
	.prevnext a[rel="next"] {
		justify-self: end;
		text-align: end;
	}
	.prevnext a[data-test="all-projects"] {
		justify-self: center;
	}
	/* 44 px tall hit area; negative margin keeps the visual rhythm unchanged (WCAG 2.5.8). */
	.prevnext a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-block: -12px;
	}
</style>
