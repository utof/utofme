---
/**
 * Phase 6 head augmentations: rel=webmention + firehose rel=alternate +
 * per-route collection alternates + rel=me identity links.
 *
 * Why: centralises <head> additions so _BaseLayout doesn't grow further.
 * Mounted as the first content node of <head> after <meta charset> +
 * <meta viewport>.
 *
 * @see packages/specs/specs/06-indieweb.md § Architecture (Self-link, MetaHead)
 * @see packages/specs/plans/06-indieweb.md § Task 4
 * @see packages/specs/plans/06-indieweb.md § Task 5
 */
import { profiles } from "../lib/profiles.ts";
import {
	absoluteUrl,
	DEFAULT_OG_IMAGE,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
	pageTitle,
} from "../lib/seo.ts";
import { forcedLightThemeScript, inlineThemeScript, LIGHT_ONLY } from "../lib/theme.ts";

interface Props {
	/** Astro.url.pathname — used for per-route <link rel="alternate"> wiring. */
	route: string;
	/** Page title (bare or already suffixed); rendered through the `<page> · utofme` template. */
	title?: string;
	/** Meta description, reused for `og:description`. */
	description?: string;
	/** `og:image` as a path or URL; defaults to the site card in `public/`. */
	image?: string | undefined;
}
const { route, title = "utofme", description = "", image } = Astro.props;

// Why: share metadata (P-11). Absolute URLs come from `Astro.site`; project pages pass a
// 1200x630 banner crop as `image`, every other page falls back to the site default card.
const fullTitle = pageTitle(title);
const resolve = (u: string): string => (Astro.site ? absoluteUrl(u, Astro.site) : u);
const canonical = resolve(route);
const ogImage = resolve(image ?? DEFAULT_OG_IMAGE);
const ogType = route.startsWith("/works/") ? "article" : "website";

// Per-route alternate-link policy locked in spec § Architecture.
// `route` is `Astro.url.pathname` with `trailingSlash: "always"`.
// Equality check (not startsWith) so detail pages do NOT match index branches.
const isHome = route === "/";
const isGardenIndex = route === "/garden/" || route === "/garden/graph/";
---

<!-- Why: LIGHT_ONLY swaps in the script that always sets data-theme="light" and
     ignores localStorage + prefers-color-scheme (light-only MVP). The original
     inlineThemeScript stays wired behind the flag.
     @see packages/specs/adrs/0040-light-only-masonry-home.md -->
<script
	is:inline
	data-astro-rerun
	set:html={LIGHT_ONLY ? forcedLightThemeScript() : inlineThemeScript()}
/>
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#ffffff" />
<meta property="og:site_name" content="utofme" />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
<link rel="webmention" href="https://webmention.io/utof.me/webmention" />
<link rel="alternate" type="application/rss+xml" title="utof.me — firehose" href="/feed.xml" />
{isHome && (
	<link rel="alternate" type="application/rss+xml" title="utof.me — works" href="/feed/works.xml" />
)}
{isGardenIndex && (
	<link
		rel="alternate"
		type="application/rss+xml"
		title="utof.me — garden"
		href="/feed/garden.xml"
	/>
)}
{profiles.map((p) => (
	<link rel="me" href={p.url} />
))}
