---
/**
 * Phase 6 head augmentations: rel=webmention + firehose rel=alternate +
 * per-route collection alternates + rel=me identity links.
 *
 * Why: centralises <head> additions so _BaseLayout doesn't grow further.
 * Mounted as the first content node of <head> after <meta charset> +
 * <meta viewport>.
 *
 * @see packages/specs/specs/06-indieweb.md § Architecture (Self-link, MetaHead)
 * @see packages/specs/plans/06-indieweb.md § Task 4
 * @see packages/specs/plans/06-indieweb.md § Task 5
 */
import { profiles } from "../lib/profiles.ts";
import { forcedLightThemeScript, inlineThemeScript, LIGHT_ONLY } from "../lib/theme.ts";

interface Props {
	/** Astro.url.pathname — used for per-route <link rel="alternate"> wiring. */
	route: string;
}
const { route } = Astro.props;

// Per-route alternate-link policy locked in spec § Architecture.
// `route` is `Astro.url.pathname` with `trailingSlash: "always"`.
// Equality check (not startsWith) so detail pages do NOT match index branches.
const isHome = route === "/";
const isGardenIndex = route === "/garden/" || route === "/garden/graph/";
---

<!-- Why: LIGHT_ONLY swaps in the script that always sets data-theme="light" and
     ignores localStorage + prefers-color-scheme (light-only MVP). The original
     inlineThemeScript stays wired behind the flag.
     @see packages/specs/adrs/0040-light-only-masonry-home.md -->
<script
	is:inline
	data-astro-rerun
	set:html={LIGHT_ONLY ? forcedLightThemeScript() : inlineThemeScript()}
/>
<link rel="webmention" href="https://webmention.io/utof.me/webmention" />
<link rel="alternate" type="application/rss+xml" title="utof.me — firehose" href="/feed.xml" />
{isHome && (
	<link rel="alternate" type="application/rss+xml" title="utof.me — works" href="/feed/works.xml" />
)}
{isGardenIndex && (
	<link
		rel="alternate"
		type="application/rss+xml"
		title="utof.me — garden"
		href="/feed/garden.xml"
	/>
)}
{profiles.map((p) => (
	<link rel="me" href={p.url} />
))}
