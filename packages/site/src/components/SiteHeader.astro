---
/**
 * SiteHeader.astro — the one header every page shares.
 *
 * Why: the wordmark and header landmark stay consistent.
 * The catalogue variant adds its sticky surface and an optional navigation slot.
 *
 * @see packages/specs/reviews/ui/polish.md (P-05, P-06)
 */
import UtofWordmark from "./UtofWordmark.astro";

interface Props {
	/** Wrap the wordmark in an `<h1>` (home has no other title). */
	heading?: boolean | undefined;
	catalogue?: boolean | undefined;
}
const { heading = false, catalogue = false } = Astro.props;
const Mark = heading ? "h1" : "p";
---

<header
	class:list={["site-header", { ct: catalogue }]}
	data-test="site-header"
	data-catalogue={catalogue ? "" : undefined}
>
	<div class:list={["header-row", { "ct-wrap": catalogue }]}>
		<Mark class="mark">
			<UtofWordmark />
		</Mark>
		<slot name="navigation" />
		<div class="controls" data-test="site-controls">
			<slot />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 1;
	}
	.site-header:not([data-catalogue]) {
		width: var(--page-width);
		margin-inline: auto;
		margin-block-end: var(--space-5);
	}
	.site-header:not([data-catalogue]) .header-row {
		box-sizing: border-box;
		padding-block-start: var(--space-6);
		min-block-size: calc(var(--space-6) + var(--utof-wordmark-size));
	}
	.header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}
	.mark {
		margin: 0;
		line-height: 1;
	}
	.site-header:not([data-catalogue]) .mark {
		/* Keep font descenders from adding a line-box gap below the SVG. */
		display: grid;
	}
	.controls {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: var(--space-2);
	}
	[data-catalogue] {
		background: var(--ct-page);
		z-index: 10;
	}
	[data-catalogue] .header-row {
		flex-wrap: wrap;
		gap: 0 16px;
		padding-block-start: 10px;
	}
	[data-catalogue] .mark {
		margin-inline-end: auto;
	}
	[data-catalogue] .controls :global(.site-ctl) {
		block-size: 32px;
		padding: 0 10px;
		font-family: var(--ct-font-pixel);
		font-size: 20px;
		color: var(--ct-ink);
		background: transparent;
		border: 2px solid var(--ct-ink);
		border-radius: 0;
	}
	[data-catalogue] .controls :global(.site-ctl:hover) {
		background: var(--ct-paper);
		border-color: var(--ct-ink);
	}
	@media (min-width: 800px) {
		[data-catalogue] {
			position: sticky;
			inset-block-start: 0;
		}
		[data-catalogue] .header-row {
			flex-wrap: nowrap;
			gap: 0 24px;
			block-size: var(--ct-top-h);
			box-sizing: border-box;
		}
	}
</style>
