---
/**
 * MapStagesBlock.astro — MDX-facing block for figure F5 (From a CS2 map to 28×28).
 *
 * Why: stub from the layout lane so every later lane has a lab page and an MDX
 * entry point; the owning figure lane replaces the placeholder with the keyframe
 * and the `client:visible` island.
 *
 * @see packages/specs/specs/10-tactical-arena-article.md § Figures: common contract
 */
import Figure from "./Figure.astro";

/** Props for MapStagesBlock. */
export interface Props {
	/** Reading-order figure number, set in the MDX. */
	number: number;
}

const { number } = Astro.props;
---

<Figure id="f5" number={number} width="wide" aspect="16 / 9" minBlock="20rem">
	<p data-stub>From a CS2 map to 28×28 (placeholder)</p>
	<slot name="caption" slot="caption" />
	<slot name="try" slot="try" />
</Figure>
