---
/**
 * Persistent sound toggle button. Default off. Lazily creates an AudioContext
 * on the first opt-in click (browser autoplay policy: AudioContext may only be
 * resumed after a user gesture — see MDN autoplay guide linked below).
 *
 * Why hand-rolled vs howler.js: a 30 KB library for two ≤ 200 ms clips and
 * ~30 LOC of glue is not a justified trade-off. See ADR 0037.
 *
 * Audio files are synthesised CC0 sine-wave pings generated by
 * packages/site/scripts/build-audio.sh (ffmpeg aevalsrc). Provenance: public
 * domain, generated programmatically — no third-party recording sourced.
 *
 * @see packages/specs/specs/07-atmosphere.md § T2
 * @see packages/specs/plans/07-atmosphere.md § T2
 * @see packages/specs/adrs/0037-web-audio-no-howler.md
 * @see https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API
 * @see https://developer.mozilla.org/en-US/docs/Web/Media/Guides/Autoplay_guide
 */
---

<button type="button" class="site-ctl" data-sound-toggle aria-pressed="false">
	<svg
		aria-hidden="true"
		viewBox="0 0 16 16"
		width="16"
		height="16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<!-- Speaker: box + cone -->
		<path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor"></path>
		<!-- Sound-on waves (hidden via CSS when aria-pressed="false") -->
		<path class="sound-on" d="M10.5 5.8a3 3 0 0 1 0 4.4"></path>
		<path class="sound-on" d="M12.2 4a5.5 5.5 0 0 1 0 8"></path>
		<!-- Muted cross (hidden via CSS when aria-pressed="true") -->
		<path class="sound-off" d="M10.5 6l4 4M14.5 6l-4 4"></path>
	</svg>
	<!-- Why: a visible text label (no aria-label) so the accessible name matches what is shown;
	     CSS swaps the two spans on aria-pressed. -->
	<span class="lbl lbl-on">Sound on</span>
	<span class="lbl lbl-off">Sound off</span>
</button>

<!-- Why data-astro-rerun: ClientRouter swaps <body> on SPA navigation and re-runs only
     inline scripts that carry this attribute; without it the new button would have no
     click handler. The script has no define:vars, so rerun is the only reason for it.
     Re-runs rebind the button via `onclick=` (overwrites, no stacking); the document and
     window listeners are bound once behind a `window.__utofmeSound` guard (#147).
     @see https://docs.astro.build/en/guides/view-transitions/#script-behavior-with-view-transitions
     @issue utof/utofme#102 -->
<script is:inline data-astro-rerun>
	(function () {
		var KEY = "utofme:sound";
		var btn = document.querySelector("[data-sound-toggle]");
		if (!btn) return;
		function isOn() {
			return localStorage.getItem(KEY) === "on";
		}
		btn.setAttribute("aria-pressed", isOn() ? "true" : "false");

		// Why: one audio state and one pair of listeners per page lifetime; reruns only
		// rebind the button. @issue utof/utofme#147
		var s = window.__utofmeSound;
		if (!s) {
			s = window.__utofmeSound = { ctx: null, buffers: {}, ready: null };
			var fmt =
				typeof Audio !== "undefined" && new Audio().canPlayType("audio/webm") ? "webm" : "mp3";
			s.ensure = function () {
				if (s.ready) return s.ready;
				s.ctx = new (window.AudioContext || window.webkitAudioContext)();
				s.ready = Promise.all(
					["cmd-k", "hover"].map(function (n) {
						return fetch("/audio/" + n + "." + fmt)
							.then(function (r) {
								return r.arrayBuffer();
							})
							.then(function (a) {
								return s.ctx.decodeAudioData(a);
							})
							.then(function (b) {
								s.buffers[n] = b;
							});
					}),
				);
				return s.ready;
			};
			s.play = function (name) {
				if (!s.ctx || !s.buffers[name]) return;
				var src = s.ctx.createBufferSource();
				src.buffer = s.buffers[name];
				src.connect(s.ctx.destination);
				src.start();
			};

			document.addEventListener("pointerover", function (e) {
				if (!isOn() || !(e.target instanceof Element) || !e.target.closest("[data-sound]")) return;
				s.ensure().then(function () {
					s.play("hover");
				});
			});

			window.addEventListener(
				"keydown",
				function (e) {
					if (!isOn()) return;
					if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")
						s.ensure().then(function () {
							s.play("cmd-k");
						});
				},
				{ capture: true },
			);
		}

		btn.onclick = function () {
			var on = !isOn();
			localStorage.setItem(KEY, on ? "on" : "off");
			btn.setAttribute("aria-pressed", on ? "true" : "false");
			if (on) s.ensure();
		};

		if (isOn()) s.ensure();
	})();
</script>

<style>
	/* Look, size and hit zone: shared `.site-ctl` rule in _BaseLayout. */
	[data-sound-toggle][aria-pressed="true"] svg {
		opacity: 1;
	}
	[data-sound-toggle][aria-pressed="false"] svg {
		opacity: 0.6;
	}
	/* Waves show when sound is on, the cross when it is off */
	[data-sound-toggle][aria-pressed="true"] .sound-off,
	[data-sound-toggle][aria-pressed="false"] .sound-on,
	[data-sound-toggle][aria-pressed="true"] .lbl-off,
	[data-sound-toggle][aria-pressed="false"] .lbl-on {
		display: none;
	}
</style>
