---
/**
 * Gallery.astro — 3–5 captioned figures beside (≥1200 px) or under the project body.
 *
 * Why: anatomy item 5. Items with a `loop` render LoopMedia (size "gallery",
 * no persist id); the rest are stills wrapped in a `<button data-zoom>` that
 * opens the shared `<dialog class="lightbox">` at full resolution
 * (`src/lib/lightbox.ts`). Captions state claims (≤ 100 chars, enforced by the
 * schema). Renders nothing for an empty list.
 *
 * Frames are 16:9. Stills use `object-fit: contain` on the neutral surface:
 * gallery images are UI screenshots with small text, and a cover crop would cut
 * the very labels the caption talks about. Loops are footage, so they cover.
 *
 * @see packages/specs/specs/09-project-view.md § P9-8
 * @see packages/specs/reviews/ui/polish.md (P-03, P-08)
 */
import LoopMedia from "./LoopMedia.astro";
import ProjectStill from "./ProjectStill.astro";
import type { GalleryItem } from "../lib/project-fields";

export interface Props {
	items: GalleryItem[];
}
const { items } = Astro.props;
const hasStills = items.some((it) => !it.loop);
---

{items.length > 0 && (
	<>
		<section class="gallery" aria-label="Gallery" data-test="gallery">
			{items.map((it) => (
				<figure>
					{it.loop ? (
						<div class="frame loop">
							<LoopMedia slug={it.loop} size="gallery" alt={it.alt} />
						</div>
					) : (
						<button
							type="button"
							class="frame zoom"
							data-zoom
							data-full={it.src.src}
							data-alt={it.alt}
							data-caption={it.caption}
							aria-label={`Enlarge: ${it.alt}`}
						>
							<ProjectStill
								src={it.src}
								alt=""
								sizes="(min-width: 1200px) 50vw, (min-width: 700px) 45vw, 100vw"
								focus={it.focus}
							/>
						</button>
					)}
					<figcaption>{it.caption}</figcaption>
				</figure>
			))}
		</section>
		{hasStills && (
			<dialog class="lightbox" aria-label="Enlarged image">
				<figure>
					<img alt="" />
					<figcaption />
				</figure>
				<button type="button" class="nav prev" data-step="-1" aria-label="Previous image">
					‹
				</button>
				<button type="button" class="nav next" data-step="1" aria-label="Next image">
					›
				</button>
				<button type="button" class="close" data-close aria-label="Close">
					×
				</button>
			</dialog>
		)}
	</>
)}

<script>
	import { installLightbox } from "../lib/lightbox";
	document.addEventListener("astro:page-load", () => installLightbox());
</script>

<style>
	.gallery {
		display: grid;
		gap: var(--space-5) var(--space-4);
		grid-template-columns: minmax(0, 1fr);
		margin-block: var(--space-6);
	}
	/* 2-up from ~700 px; an odd count spans the first figure so no hole is left. */
	@media (min-width: 700px) and (max-width: 1199.98px) {
		.gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.gallery > figure:first-child:nth-last-child(odd) {
			grid-column: 1 / -1;
		}
	}
	figure {
		margin: 0;
	}
	.frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		padding: 0;
		border: 0;
		background: var(--color-surface);
		border-radius: var(--radius-xs);
	}
	.frame :global(img),
	.frame :global(video),
	.frame :global(picture),
	.frame :global(.loop-frame) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.loop :global(video),
	.loop :global(img) {
		object-fit: cover;
	}
	.zoom {
		cursor: zoom-in;
	}
	.zoom:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}
	figcaption {
		margin-top: var(--space-2);
		font-size: var(--font-size-1);
		color: var(--color-text-body);
	}

	.lightbox {
		width: min(96vw, 1800px);
		max-width: none;
		max-height: 96vh;
		padding: var(--space-3);
		border: 0;
		border-radius: var(--radius-xs);
		background: var(--color-bg);
		color: var(--color-text-body);
	}
	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.78);
	}
	.lightbox figure {
		display: grid;
		gap: var(--space-2);
		justify-items: center;
	}
	.lightbox img {
		max-width: 100%;
		max-height: calc(96vh - 7rem);
		object-fit: contain;
	}
	.lightbox figcaption {
		margin: 0;
		text-align: center;
	}
	.lightbox button {
		position: absolute;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}
	.lightbox .close {
		top: var(--space-2);
		right: var(--space-2);
	}
	.lightbox .nav {
		top: 50%;
		translate: 0 -50%;
	}
	.lightbox .prev {
		left: var(--space-2);
	}
	.lightbox .next {
		right: var(--space-2);
	}
</style>
