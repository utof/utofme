---
/**
 * Card.astro — uniform outer shell for a work card.
 *
 * Why: ADR 0011 — detail page when body exists, external URL when present
 * (priority repo→youtube→listen→arxiv→pdf), else `<article>` (no link).
 * Avoids `href="#"` Axe violations and keeps Phase 1 0-KB-JS.
 * Task 6 delegates href-decision to `cardHref()` from `lib/works.ts` so the
 * branch logic is Stryker-targetable from one place.
 *
 * data-test="card-link-detail" | "card-link-external": present when the outer
 * element is `<a>`, absent (no href) when the outer element is `<article>`.
 * Used by e2e tests to assert which branch was taken.
 *
 * data-preview-target / data-title / data-date / data-summary: read by
 * Preview.svelte for the hover popover. Pure-DOM approach — no extra data
 * prop or JSON blob needed. summary omitted when undefined to keep the DOM
 * clean and let Preview detect absence via `dataset.summary === undefined`.
 *
 * Hidden <span data-pagefind-meta="…"> and <span data-pagefind-filter="…">:
 * Pagefind reads element textContent for metadata and filter values; using one
 * hidden span per field (not inline key:value on the outer element) is the
 * per-element form documented at https://pagefind.app/docs/metadata/ (verified
 * 2026-04-26). These spans are invisible to users but remain in the DOM so
 * Pagefind's indexer can read them.
 *
 * No static `transition:name`: the project-view morph names the clicked card's
 * `[data-vt-frame]` at click time (P9-9), so cards carry `data-work-slug` instead.
 *
 * variant="media": the image-first masonry card used on `/`: media on top at its
 * natural aspect ratio inside a clipping `[data-vt-frame]`, with a dark-glass
 * caption bar (title, one-line description = `lede ?? summary`, meta line
 * `year · stack`) flush at the bottom of the media. Hover = "reveal": the bar content
 * slides up to reveal the meta line (transform/opacity only); the media itself does not zoom
 * (a slideshow card plays on hover instead, see `src/lib/loops/controller.ts`). Every glyph is #fff on `--caption-bg`; contrast
 * is proven in `tests/unit/contrast.test.ts`. The `header`/`meta` slots are not
 * rendered. Why a variant and not a restyle: the bordered
 * default card is kept for the lab pages. The link mechanism is shared.
 *
 * @see packages/specs/specs/09-project-view.md § P9-7
 *
 * @see packages/specs/adrs/0011-card-click-target-strategy.md
 * @see packages/specs/adrs/0040-light-only-masonry-home.md
 * @see packages/specs/plans/02-interactivity.md § Task 7
 * @see packages/specs/plans/02-interactivity.md § Task 8
 * @see packages/specs/plans/03-content-pipeline.md § Task 6
 * @see https://pagefind.app/docs/metadata/
 */
import type { WorkEntry } from "../content.config";
import { captionParts, optionalFlag } from "../lib/card-caption";
import { cardHref } from "../lib/works";

interface Props {
	data: WorkEntry;
	/** Content-collection entry id used as the preview popover lookup key. */
	id?: string;
	/**
	 * Raw Markdown/MDX body string from the collection entry.
	 *
	 * Why: `cardHref` checks `hasBody()` to decide whether a detail page
	 * exists. Passing `entry.body` here keeps Card.astro decoupled from Astro's
	 * virtual module while allowing the body-check to work correctly.
	 * `string | undefined` (not `string?`) because callers pass `entry.body`
	 * which is `string | undefined`; `exactOptionalPropertyTypes: true` requires
	 * the explicit union form when the caller may supply `undefined`.
	 *
	 * @see packages/specs/plans/03-content-pipeline.md § Task 6
	 */
	body?: string | undefined;
	/**
	 * Visual variant: bordered `default` (lab pages) or image-first `media`
	 * (masonry home).
	 *
	 * Why: keeps one link/Pagefind/preview implementation for both layouts.
	 * `| undefined` for `exactOptionalPropertyTypes`.
	 */
	variant?: "default" | "media" | undefined;
}
const { data, id, body, variant = "default" } = Astro.props;

const href = cardHref({ id: id ?? "", body, data });
const Tag = href ? "a" : "article";
/** data-test attribute value for linked cards; undefined for <article> (no link). */
const linkTest = href
	? href.startsWith("/works/")
		? "card-link-detail"
		: "card-link-external"
	: undefined;

/** ISO date string (YYYY-MM-DD) for data-date and the Pagefind meta span. */
const dateStr = data.date.toISOString().split("T")[0];
const caption = captionParts(data);
---

<Tag
	class:list={["card", { "card--media": variant === "media" }]}
	href={href || undefined}
	data-test={linkTest}
	data-draft={data.draft ? "true" : undefined}
	data-type={data.type}
	data-tags={data.tags.join(",")}
	data-preview-target={id}
	data-title={data.title}
	data-date={dateStr}
	data-summary={data.summary}
	data-work-slug={id}
	data-fixture={optionalFlag(data, "fixture") ? "" : undefined}
>
	{variant === "media" ? (
		<div class="card-figure">
			<div data-vt-frame>
				<slot name="thumb" />
			</div>
			<div class="cap" data-cap>
				<h2 class="cap__t">{caption.title}</h2>
				{caption.description && <p class="cap__d">{caption.description}</p>}
				<p class="cap__m">{caption.meta}</p>
			</div>
		</div>
	) : (
		<>
			<slot name="header" />
			<slot name="thumb" />
			<slot name="meta" />
		</>
	)}
	<!-- Pagefind metadata: one hidden span per field; Pagefind reads textContent.
	     See https://pagefind.app/docs/metadata/ (verified 2026-04-26) -->
	<span data-pagefind-meta="title" hidden>
		{data.title}
	</span>
	<span data-pagefind-meta="date" hidden>
		{dateStr}
	</span>
	{data.summary && (
		<span data-pagefind-meta="summary" hidden>
			{data.summary}
		</span>
	)}
	<!-- Pagefind filters: one hidden span per filter value; textContent is the value. -->
	<span data-pagefind-filter="type" hidden>
		{data.type}
	</span>
	{data.tags.map((tag) => (
		<span data-pagefind-filter="tag" hidden>
			{tag}
		</span>
	))}
</Tag>

<style>
	/* v21 card: hairline rectangle, 6 px radius, white fill, 16 px padding, no
	 * shadow; a 1 px shadow appears on hover only (ADR 0042). */
	.card {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: var(--space-2);
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		text-decoration: none;
		color: inherit;
	}
	a.card:hover {
		box-shadow: var(--shadow-sm);
	}
	a.card:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
	}
	@media (prefers-reduced-motion: no-preference) {
		.card {
			transition: box-shadow var(--motion-fast) var(--ease-out);
		}
	}

	/* ─── variant="media": image-first masonry card ───────────────────────── */
	.card--media {
		display: block;
		padding: 0;
		border: 0;
		border-radius: 0;
	}
	/* Why: the figure clips the sliding bar and the rounded corners. It must NOT carry
	 * filter / opacity / mask / clip-path / will-change (a Backdrop Root would
	 * blind the bar's optional backdrop-filter). Shrink-wraps still media so the
	 * bar matches the image width; loops fill the column. */
	.card-figure {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-card);
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
	}
	.card-figure:has(.loop-frame) {
		width: 100%;
	}
	[data-vt-frame] {
		overflow: hidden;
	}
	/* Why :global — the <img>/<picture> are slotted from the page, so they carry
	 * the page's scope id, not Card's. */
	.card--media :global(picture),
	.card--media :global(img) {
		display: block;
	}
	/* Why max-height: every piece must fit on one screen (≤80vh); tall media
	 * scales down with its aspect ratio and centres in the column. The hairline +
	 * surface tint keep white-background media legible on the white page. */
	.card--media :global(img) {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 80vh;
		margin-inline: auto;
		background-color: var(--color-surface);
		outline: 1px solid var(--color-border);
		outline-offset: -1px;
	}

	/* Caption: dark glass bar, flush bottom, full width, no radius. Hierarchy by
	 * size/weight only — no grey, no semi-transparent text (contrast guarantee). */
	.cap {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		z-index: 2; /* above the flagged hover canvas (z-index 1) in the <li> */
		padding: var(--cap-pad) var(--space-3) 0;
		background: var(--caption-bg);
		color: var(--caption-fg);
		text-align: start;
	}
	/* Why no `margin: 0` here: scoped `.cap > *` outranks `.cap__d`, which dropped the bottom
	 * pads and let the rest-state translate clip the description. Margins are set per line. */
	.cap > * {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--caption-fg);
	}
	.cap__t {
		font-family: var(--font-sans);
		font-size: 0.9375rem; /* 15 px */
		font-weight: 600;
		letter-spacing: 0;
		line-height: var(--leading-snug);
		margin: 0;
	}
	.cap__d {
		font-family: var(--font-sans);
		font-size: var(--font-size-ui); /* 13 px */
		font-weight: 400;
		line-height: var(--leading-snug);
		margin: 0 0 var(--cap-pad);
	}
	/* Description is optional: keep the pad under the title when it is absent. */
	.cap__t:has(+ .cap__m) {
		margin-bottom: var(--cap-pad);
	}
	.cap__m {
		font-family: var(--font-mono);
		font-size: 0.75rem; /* 12 px floor */
		font-weight: 400;
		font-variant-numeric: tabular-nums;
		line-height: var(--cap-meta-h);
		height: var(--cap-meta-h);
		margin: 0 0 var(--cap-pad);
	}

	/* Opt-in blur (perf-gated, see tokens.css): only the hovered/focused bar. */
	@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
		:global(html[data-caption-blur]) {
			--caption-blur: var(--caption-blur-on);
		}
		a.card--media:is(:hover, :focus-visible) .cap {
			-webkit-backdrop-filter: var(--caption-blur);
			backdrop-filter: var(--caption-blur);
		}
	}

	/* ─── Hover "reveal" (fine pointers only, motion allowed) ──────────────── */
	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		:global(html:not([data-motion="paused"])) .card--media .cap {
			transform: translateY(calc(var(--cap-meta-h) + var(--cap-pad)));
			transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
		}
		:global(html:not([data-motion="paused"])) .card--media .cap__m {
			opacity: 0;
			transition: opacity 160ms var(--ease-out);
		}
		:global(html:not([data-motion="paused"])) a.card--media:hover .cap {
			transform: none;
			transition: transform 220ms var(--ease-out) 50ms;
		}
		:global(html:not([data-motion="paused"])) a.card--media:hover .cap__m {
			opacity: 1;
			transition: opacity 160ms var(--ease-out) 110ms; /* 50 ms intent + 60 ms delay */
		}
	}
	/* Keyboard parity: the same end state on any device, ungated; the focus ring
	 * stays on the <a>, outside the clipped figure. */
	a.card--media:focus-visible .cap {
		transform: none;
	}
	a.card--media:focus-visible .cap__m {
		opacity: 1;
	}
	a.card--media:hover {
		outline: none;
		box-shadow: none;
	}
	a.card--media:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
		border-radius: var(--radius-xs);
	}

	/* ─── Phone / touch: a slimmer bar ─────────────────────────────────────── */
	/* Why: at 390 px the 3-line bar covered 44 % of each card. Touch has no hover to
	 * reveal the meta line, so drop it (the project page shows it) and keep the
	 * description to its single ellipsised line (`.cap > *` is nowrap); nothing slides,
	 * so the reveal translate is 0. Declared last so it outranks the hover rules above. */
	@media (pointer: coarse), (max-width: 639px) {
		.card--media {
			--cap-meta-h: 0px;
		}
		.card--media .cap__m {
			display: none;
		}
		.card--media .cap__d {
			margin-bottom: 0;
		}
		.card--media .cap {
			padding-block-end: var(--cap-pad);
		}
		:global(html:not([data-motion="paused"])) .card--media .cap,
		:global(html:not([data-motion="paused"])) a.card--media:hover .cap {
			transform: none;
		}
	}
</style>
