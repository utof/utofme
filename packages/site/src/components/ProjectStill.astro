---
/**
 * ProjectStill.astro — a still image that fills its frame (banner / gallery).
 *
 * Why: CoverImage caps at 80vh with `width:auto`; the banner and gallery need
 * `width/height:100%` + object-fit cover inside a fixed-aspect clipping frame.
 * Animated GIFs bypass <Picture> (see CoverImage.astro for the sharp issue).
 *
 * @see packages/site/src/components/CoverImage.astro
 * @see packages/specs/specs/09-project-view.md § P9-8
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
	src: ImageMetadata;
	alt: string;
	/** `sizes` hint for the responsive srcset. */
	sizes?: string | undefined;
	/** Load eagerly + high priority (the banner, which is the LCP element). */
	eager?: boolean | undefined;
	/** object-position y, percent. */
	focus?: number | undefined;
}
const {
	src,
	alt,
	sizes = "(min-width: 1280px) 1280px, 100vw",
	eager = false,
	focus = 50,
} = Astro.props;
const style = `object-position:50% ${focus}%`;
---

{src.format === "gif" ? (
	<img
		src={src.src}
		width={src.width}
		height={src.height}
		alt={alt}
		loading={eager ? "eager" : "lazy"}
		decoding="async"
		style={style}
	/>
) : (
	<Picture
		src={src}
		formats={["avif", "webp"]}
		widths={[640, 960, 1280]}
		sizes={sizes}
		alt={alt}
		loading={eager ? "eager" : "lazy"}
		decoding={eager ? "sync" : "async"}
		fetchpriority={eager ? "high" : undefined}
		style={style}
	/>
)}
