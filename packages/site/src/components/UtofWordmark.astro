---
const letters = [
	{ x: 0, y: 0, rows: ["10001", "10001", "10001", "10001", "11111"] },
	{ x: 6, y: 0, rows: ["10000", "10000", "11100", "10000", "11111"] },
	{ x: 0, y: 6, rows: ["11111", "10001", "10001", "10001", "11111"] },
	{ x: 6, y: 6, rows: ["11111", "10000", "11100", "10000", "10000"] },
];
---

<a class="utof-mark" href="/" data-test="wordmark" aria-label="utofme">
	<svg
		width="33"
		height="33"
		viewBox="0 0 11 11"
		fill="currentColor"
		aria-hidden="true"
		focusable="false"
	>
		<g data-wordmark-blocks>
			{letters.map(({ x, y, rows }) => (
				<path
					data-wordmark-tile
					data-x={x}
					data-y={y}
					data-grid={rows.join("")}
					d={rows
						.flatMap((row, dy) =>
							Array.from(
								row.matchAll(/1+/g),
								(match) => `M${x + match.index} ${y + dy}h${match[0].length}v1H${x + match.index}Z`,
							),
						)
						.join("")}
				/>
			))}
		</g>
		<g data-wordmark-pixels></g>
	</svg>
</a>

<script>
	import { bindWordmark } from "../lib/wordmark-motion";

	let dispose: (() => void) | undefined;
	function mount(): void {
		const mark = document.querySelector<HTMLAnchorElement>('[data-test="wordmark"]');
		if (dispose || !mark) return;
		dispose = bindWordmark(mark);
	}

	mount();
	document.addEventListener("astro:after-swap", mount);
	document.addEventListener("astro:before-swap", () => {
		dispose?.();
		dispose = undefined;
	});
</script>

<style>
	.utof-mark {
		display: inline-grid;
		align-items: center;
		min-inline-size: 44px;
		min-block-size: 44px;
		color: inherit;
	}
	svg {
		display: block;
		inline-size: var(--utof-wordmark-size, 33px);
		block-size: var(--utof-wordmark-size, 33px);
		overflow: visible;
		pointer-events: none;
		shape-rendering: crispEdges;
	}
	[data-wordmark-tile] {
		transform-box: fill-box;
		transform-origin: center;
		transition:
			transform 170ms cubic-bezier(0.16, 1, 0.3, 1),
			filter 170ms ease-out;
	}
	[data-wordmark-pixels] > :global(rect) {
		transition:
			transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
			fill 130ms ease-out;
	}
	.utof-mark[data-wordmark-renderer="pixels"] [data-wordmark-blocks],
	.utof-mark:not([data-wordmark-renderer="pixels"]) [data-wordmark-pixels] {
		visibility: hidden;
	}
	.utof-mark[data-wordmark-mode="block-flip"] svg {
		shape-rendering: geometricPrecision;
	}
	:global(html[data-motion="paused"]) .utof-mark svg :global(*) {
		transition: none;
	}
</style>
