---
/**
 * Footer h-card. Declares the site's own identity for indieweb tools.
 *
 * Why: rendered as one quiet line ("utof.me — Personal site and portfolio. · GitHub
 * @utof") instead of a three-line block; the mf2 classes (`h-card`, `u-url p-name`,
 * `p-note`, `rel=me`) are unchanged.
 *
 * @see packages/specs/specs/06-indieweb.md § Architecture (Microformats markup)
 * @see packages/specs/reviews/ui/polish.md (P-04)
 */
import { profiles } from "../lib/profiles.ts";
---

<aside class="h-card">
	<a class="u-url p-name" href="/">
		utof.me
	</a>
	<span class="sep" aria-hidden="true">
		—
	</span>
	<span class="p-note">Personal site and portfolio.</span>
	<ul>
		{profiles.map((p) => (
			<li>
				<a class="u-url" rel="me" href={p.url}>
					{p.label}
				</a>
			</li>
		))}
	</ul>
</aside>

<style>
	/* Why: `opacity: 0.7` washed the v21 link blue down to 3.26:1 on white. The
	 * h-card matches the footer meta row below it: muted text, links inherit,
	 * hover restores the strong text colour (ADR 0042). */
	.h-card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: var(--space-2);
		font-size: var(--font-size-ui);
		color: var(--color-text-muted);
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-2);
	}
	.h-card a {
		color: inherit;
		text-decoration: none;
	}
	.h-card a:hover {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-focus);
	}
	.h-card ul {
		display: flex;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* Link list joins the same line after a middle dot. */
	.h-card ul::before {
		content: "·";
		margin-inline-end: var(--space-3);
	}
	.h-card .sep {
		margin-inline-end: 0;
	}
</style>
