---
/**
 * Footer h-card. Declares the site's own identity for indieweb tools.
 * @see packages/specs/specs/06-indieweb.md § Architecture (Microformats markup)
 */
import { profiles } from "../lib/profiles.ts";
---

<aside class="h-card">
	<a class="u-url p-name" href="/">utof.me</a>
	<p class="p-note">Personal site and portfolio.</p>
	<ul>
		{
			profiles.map((p) => (
				<li>
					<a class="u-url" rel="me" href={p.url}>
						{p.label}
					</a>
				</li>
			))
		}
	</ul>
</aside>

<style>
	/* Why: `opacity: 0.7` washed the v21 link blue down to 3.26:1 on white. The
	 * h-card now matches the footer meta row below it: muted text, links
	 * inherit, hover restores the strong text colour (ADR 0042). */
	.h-card {
		font-size: 0.85em;
		color: var(--color-text-muted);
	}
	.h-card a {
		color: inherit;
		text-decoration: none;
	}
	.h-card a:hover {
		color: var(--color-text);
		text-decoration: underline;
	}
	.h-card ul {
		display: flex;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}
</style>
