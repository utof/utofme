---
/**
 * /colophon — How this site is built. Sources content from the `slash`
 * MDX collection entry id `colophon`.
 *
 * @see packages/specs/specs/04-slash-pages.md § Acceptance criteria 1
 */
import { getEntry, render } from "astro:content";
import SlashLayout from "../layouts/_SlashLayout.astro";

const entry = await getEntry("slash", "colophon");
if (!entry) throw new Error("Missing slash/colophon MDX entry — required at build time.");
const { Content } = await render(entry);
---

<SlashLayout
	id="colophon"
	title={entry.data.title}
	description={entry.data.description}
	updated={entry.data.updated}
>
	<Content />
</SlashLayout>
