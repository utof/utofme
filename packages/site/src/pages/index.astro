---
/**
 * Home — load the works, build the home model, render the curated layout.
 *
 * Why: this page holds no design and no project names. What is featured lives in
 * `src/data/home.ts`, topics in `src/data/topics.ts`, the grouping in
 * `buildHomeModel`, and the look in a layout folder under `src/components/home/`.
 *
 * @see packages/specs/adrs/0061-catalogue-home-curated-model.md
 * @see packages/site/src/components/home/README.md
 */
import HomeLayout from "../components/home/HomeLayout.astro";
import { HOME } from "../data/home";
import { OTHER_TOPIC, TOPICS } from "../data/topics";
import { buildHomeModel } from "../lib/home/model";
import { listWorks } from "../lib/works";
import { getWorksCollection } from "../lib/works-collection";

const all = await getWorksCollection(({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);
const model = buildHomeModel(listWorks(all), HOME, { list: TOPICS, other: OTHER_TOPIC });
---

<HomeLayout layout={HOME.layout} model={model} />
