---
/**
 * Home — light-only, image-first masonry of the `works` collection.
 *
 * Why: the MVP strips the home page to "site name + masonry + footer" so the
 * media does the talking. FilterBar, TypeGlyph, MetaPills, Preview, ClickCounter
 * and the Phase-0 typography sentinel are intentionally NOT rendered here (hide,
 * don't delete — the components, the Zod `type` field and their tests remain;
 * `/works/` still renders the full filterable grid). The ~350 px gap under the
 * header came from the sentinel's `<Frame>` (aspect-ratio 16/9), now gone.
 *
 * Masonry = CSS multi-column: items keep their natural aspect ratio and pack
 * vertically with no row holes; order flows column-major (top-to-bottom through
 * column 1, then column 2, ...).
 *
 * @see packages/specs/adrs/0040-light-only-masonry-home.md
 * @see packages/specs/specs/01-card-grid-mvp.md § URL routes added or changed
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/_BaseLayout.astro";
import Card from "../components/Card.astro";
import CoverImage from "../components/CoverImage.astro";
import CodeThumb from "../components/thumbs/CodeThumb.astro";
import VideoThumb from "../components/thumbs/VideoThumb.astro";
import MusicThumb from "../components/thumbs/MusicThumb.astro";
import MathThumb from "../components/thumbs/MathThumb.astro";
import WritingThumb from "../components/thumbs/WritingThumb.astro";
import { listWorks } from "../lib/works";

const all = await getCollection("works", ({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);
const works = listWorks(all);

/** Fallback thumbs for works without a `cover`. */
const ThumbFor = {
	code: CodeThumb,
	video: VideoThumb,
	music: MusicThumb,
	math: MathThumb,
	writing: WritingThumb,
} as const;

/** Mirrors the column breakpoints in the stylesheet below (--masonry-cols / 2 / 1 columns). */
const COVER_SIZES = "(min-width: 560px) 50vw, 100vw";
---

<BaseLayout title="utofme" minimal>
	<main>
		<header class="site-head">
			<h1>utofme</h1>
		</header>

		<ul class="masonry" data-test="works-grid">
			{
				works.map((entry) => {
					const Thumb = ThumbFor[entry.data.type];
					const cover = entry.data.cover;
					return (
						<li>
							<Card variant="media" data={entry.data} id={entry.id} body={entry.body}>
								{cover ? (
									<CoverImage slot="thumb" src={cover.src} alt={cover.alt} sizes={COVER_SIZES} />
								) : (
									<Thumb slot="thumb" />
								)}
								<header slot="header">
									<h2>{entry.data.title}</h2>
								</header>
							</Card>
						</li>
					);
				})
			}
		</ul>
	</main>
</BaseLayout>

<!--
  Inline filter script — applies URL params to the DOM grid on initial load
  and on every works:filter event dispatched by FilterBar.

  MVP note: FilterBar is not rendered on `/` any more, so no UI dispatches
  works:filter; the script is kept so `/?type=…&tag=…` deep links still filter.

  Why: `is:inline` skips Astro bundling so this runs synchronously before paint,
  preventing CLS from a late filter application. The script reads data-type and
  data-tags attrs on each card, then toggles hidden on the parent <li>.
  See: https://docs.astro.build/en/guides/client-side-scripts/#opting-out-of-processing

  Why hidden on <li>: display:grid on .card overrides the UA hidden style;
  hiding the <li> wrapper removes the item from grid flow entirely.

  @see packages/specs/plans/02-interactivity.md § Task 5
-->
<script is:inline>
	function applyFilter() {
		var params = new URLSearchParams(window.location.search);
		var activeType = params.get("type");
		var activeTags = params.getAll("tag");
		var grid = document.querySelector('[data-test="works-grid"]');
		if (!grid) return;
		var items = grid.querySelectorAll("li");
		for (var i = 0; i < items.length; i++) {
			var li = items[i];
			var card = li.querySelector("[data-type]");
			if (!card) continue;
			var cardType = card.getAttribute("data-type");
			var cardTagsRaw = card.getAttribute("data-tags") || "";
			var cardTags = cardTagsRaw ? cardTagsRaw.split(",") : [];
			var typeMatch = !activeType || cardType === activeType;
			var tagMatch =
				activeTags.length === 0 ||
				activeTags.every(function (t) {
					return cardTags.indexOf(t) !== -1;
				});
			li.hidden = !(typeMatch && tagMatch);
		}
	}

	// Apply on initial load (handles hard-refresh with URL params)
	applyFilter();

	// Re-apply whenever FilterBar dispatches a filter event
	document.addEventListener("works:filter", applyFilter);

	// Re-apply on popstate (back/forward navigation)
	window.addEventListener("popstate", applyFilter);

	// Re-apply on Astro view-transition page-load (Task 12 wires ClientRouter site-wide).
	// Why: ClientRouter swaps <body> on nav and re-runs inline scripts; the filter must
	// re-apply against the new DOM. astro:page-load fires once per nav (initial + swaps).
	document.addEventListener("astro:page-load", applyFilter);
</script>

<!--
  Hover-effect loader (experimental, OFF by default): `dither` or `mosh`.

  Why: the flag checks are the only code shipped to everyone (a few hundred bytes);
  each effect module is a dynamic import() that is only fetched when its flag is on
  (`?dither` / `?mosh`, or the persisted `utofme:dither` / `utofme:mosh` flag;
  `=0` switches it off). The two are mutually exclusive: `mosh` wins when both
  resolve on. `/?mosh&m-block=8&...` also carries datamosh tunables (see
  `src/lib/datamosh/config.ts`; the `/lab/datamosh/` playground generates these URLs).
  Re-runs on astro:page-load so ClientRouter navigations re-arm it; the modules
  dispose themselves on astro:before-swap.

  @see packages/specs/adrs/0040-light-only-masonry-home.md
  @see packages/specs/adrs/0041-datamosh-cpu-canvas-hover.md
-->
<script>
	import { browserStorage, resolveFlag } from "../lib/flags";

	async function armHoverEffect(): Promise<void> {
		const grid = document.querySelector<HTMLElement>('[data-test="works-grid"]');
		if (!grid) return;
		const search = window.location.search;
		const storage = browserStorage();
		// Resolve both so `?dither=0` / `?mosh=0` always update their persisted flags.
		const mosh = resolveFlag("mosh", search, storage);
		const dither = resolveFlag("dither", search, storage);
		if (mosh) {
			const { mountCardMosh } = await import("../lib/datamosh/card-mosh");
			mountCardMosh(grid);
		} else if (dither) {
			const { mountCardDither } = await import("../lib/dither/card-dither");
			mountCardDither(grid);
		}
	}

	document.addEventListener("astro:page-load", () => void armHoverEffect());
</script>

<style>
	main {
		width: min(100% - 2 * var(--page-margin), 1800px);
		margin-inline: auto;
		padding-block: var(--space-6) var(--space-7);
	}

	.site-head {
		margin-bottom: var(--space-6);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--font-size-6);
		font-weight: 600;
		line-height: 1.1;
		margin-block: 0;
	}

	/* Masonry: CSS multi-column. --masonry-gap (tokens.css) drives the column gap
	 * AND the vertical gap between items; set it to 0 for an edge-to-edge mosaic. */
	.masonry {
		list-style: none;
		padding: 0;
		margin: 0;
		column-count: 1;
		column-gap: var(--masonry-gap);
	}

	.masonry > li {
		break-inside: avoid;
		margin: 0 0 var(--masonry-gap);
		/* Containing block for the hover-dither canvas (flagged, see script above). */
		position: relative;
	}

	@media (min-width: 560px) {
		.masonry {
			column-count: 2;
		}
	}

	/* --masonry-cols: desktop column count (trying 2; was 3). */
	@media (min-width: 1000px) {
		.masonry {
			--masonry-cols: 2;
			column-count: var(--masonry-cols);
		}
	}
</style>
