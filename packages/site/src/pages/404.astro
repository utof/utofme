---
/**
 * 404 — light-token not-found page served by Workers Static Assets
 * (`assets.not_found_handling: "404-page"` serves dist/404.html).
 *
 * Why: without it Astro's default dark template shows on unknown URLs.
 * @see https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
 * @see packages/specs/reviews/ui/breaker-desktop.md (B-03)
 */
import BaseLayout from "../layouts/_BaseLayout.astro";
---

<BaseLayout title="Not found" description="This page does not exist." noindex>
	<main>
		<h1>Page not found</h1>
		<p>
			That address leads nowhere. <a href="/">Back to the home page →</a>
		</p>
	</main>
</BaseLayout>

<style>
	main {
		width: var(--page-width);
		margin-inline: auto;
		padding-block: 0 var(--space-6);
	}
	p {
		color: var(--color-text-body);
		margin: 0;
	}
</style>
