---
/**
 * /works — archive of all work entries.
 *
 * Why: Phase 1 mirrors `/` content (no truncation yet); Phase 2 introduces
 * "latest 6 on /, full list on /works" filtering.
 *
 * @see packages/specs/specs/01-card-grid-mvp.md § URL routes added or changed
 * @see packages/specs/plans/02-interactivity.md § Task 6
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/_BaseLayout.astro";
import Stack from "../../components/Stack.astro";
import Grid from "../../components/Grid.astro";
import Card from "../../components/Card.astro";
import TypeGlyph from "../../components/TypeGlyph.astro";
import MetaPills from "../../components/MetaPills.astro";
import CodeThumb from "../../components/thumbs/CodeThumb.astro";
import VideoThumb from "../../components/thumbs/VideoThumb.astro";
import MusicThumb from "../../components/thumbs/MusicThumb.astro";
import MathThumb from "../../components/thumbs/MathThumb.astro";
import WritingThumb from "../../components/thumbs/WritingThumb.astro";
import FilterBar from "../../components/FilterBar.svelte";
import { listWorks } from "../../lib/works";

const all = await getCollection("works", ({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);
const works = listWorks(all);

const ThumbFor = {
	code: CodeThumb,
	video: VideoThumb,
	music: MusicThumb,
	math: MathThumb,
	writing: WritingThumb,
} as const;
---

<BaseLayout title="works · utofme">
	<main>
		<Stack gap="6">
			<h1>Works</h1>

			<FilterBar client:load />

			<Grid as="ul" class="works-grid" data-test="works-grid">
				{
					works.map((entry) => {
						const Thumb = ThumbFor[entry.data.type];
						return (
							<li>
								<Card data={entry.data}>
									<header slot="header">
										<TypeGlyph type={entry.data.type} />
										<h2>{entry.data.title}</h2>
									</header>
									<Thumb slot="thumb" />
									<MetaPills slot="meta" date={entry.data.date} tagCount={entry.data.tags.length} />
								</Card>
							</li>
						);
					})
				}
			</Grid>
		</Stack>
	</main>
</BaseLayout>

<!--
  Inline filter script — applies URL params to the DOM grid on initial load
  and on every works:filter event dispatched by FilterBar.

  Why: mirrors the identical script on `/` (index.astro § Task 5) so /works
  has the same URL-driven filtering behaviour without duplication in JS bundles.
  `is:inline` skips Astro bundling so this runs synchronously before paint.
  See: https://docs.astro.build/en/guides/client-side-scripts/#opting-out-of-processing

  @see packages/specs/plans/02-interactivity.md § Task 6
-->
<script is:inline>
	function applyFilter() {
		var params = new URLSearchParams(window.location.search);
		var activeType = params.get("type");
		var activeTags = params.getAll("tag");
		var grid = document.querySelector('[data-test="works-grid"]');
		if (!grid) return;
		var items = grid.querySelectorAll("li");
		for (var i = 0; i < items.length; i++) {
			var li = items[i];
			var card = li.querySelector("[data-type]");
			if (!card) continue;
			var cardType = card.getAttribute("data-type");
			var cardTagsRaw = card.getAttribute("data-tags") || "";
			var cardTags = cardTagsRaw ? cardTagsRaw.split(",") : [];
			var typeMatch = !activeType || cardType === activeType;
			var tagMatch =
				activeTags.length === 0 ||
				activeTags.every(function (t) {
					return cardTags.indexOf(t) !== -1;
				});
			li.hidden = !(typeMatch && tagMatch);
		}
	}

	// Apply on initial load (handles hard-refresh with URL params)
	applyFilter();

	// Re-apply whenever FilterBar dispatches a filter event
	document.addEventListener("works:filter", applyFilter);

	// Re-apply on popstate (back/forward navigation)
	window.addEventListener("popstate", applyFilter);

	// Re-apply on Astro view-transition page-load (Task 12 wires ClientRouter site-wide).
	document.addEventListener("astro:page-load", applyFilter);
</script>

<style>
	main {
		padding: var(--space-6);
		max-width: 80ch;
		margin-inline: auto;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: var(--font-size-6);
		font-weight: 600;
		line-height: 1.1;
		margin-block: 0;
	}

	.works-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: var(--space-4);
		max-width: min(1280px, 100%);
	}

	@media (max-width: 480px) {
		.works-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
