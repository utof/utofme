---
/**
 * /search — Pagefind-powered full-text search page.
 *
 * Why: static route that mounts the Pagefind UI widget (astro-pagefind
 * integration builds the index into dist/pagefind/ at build time).
 * Link preview is not mounted here.
 *
 * @see packages/specs/plans/02-interactivity.md § Task 11
 * @see packages/specs/plans/02-interactivity.md § Task 7 (Preview stays page-level)
 */
import BaseLayout from "../layouts/_BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
---

<BaseLayout title="search · utofme" description="Search all works and posts on utofme.">
	<main>
		<header class="site-head">
			<a class="wordmark" href="/" data-test="wordmark">
				utofme
			</a>
		</header>
		<h1>Search</h1>
		<SearchBox />
	</main>
</BaseLayout>

<style>
	main {
		width: var(--page-width);
		margin-inline: auto;
		padding-block: var(--space-6);
	}
	.site-head {
		margin-bottom: var(--space-6);
	}
	.wordmark {
		font-size: var(--font-size-6);
		font-weight: 600;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		text-decoration: none;
	}
	main > :global(*:not(.site-head)) {
		max-width: 80ch;
	}

	h1 {
		/* v21: headings are Geist 600, tight tracking (ADR 0042). */
		font-family: var(--font-sans);
		font-size: var(--font-size-6);
		font-weight: 600;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-block: 0 var(--space-4);
	}
</style>
