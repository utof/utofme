---
/**
 * _WorkLayout.astro — project page shell ("Tier S" anatomy, spec P9-8).
 *
 * Order: banner → title + lede → one meta row → body → gallery → research
 * slot → prev/next. Webmentions and h-entry microformats are unchanged.
 *
 * Why: the banner frame is `[data-vt-frame][data-work-slug]` so hero-morph can
 * pair it with the clicked card (the name is applied at navigation time, never
 * statically; the old `transition:name` on the h1 is gone). Projects without a
 * loop fall back to the still cover in the same frame; without any cover no
 * banner renders. Leading underscore signals "layout, not a routable page".
 *
 * @see packages/specs/specs/09-project-view.md § P9-8
 * @see packages/specs/specs/09-project-view.md § P9-9
 * @see packages/specs/plans/03-content-pipeline.md § Task 4
 */
import type { CollectionEntry } from "astro:content";
import Gallery from "../components/Gallery.astro";
import MotionToggle from "../components/MotionToggle.astro";
import PrevNext from "../components/PrevNext.astro";
import ProjectBanner from "../components/ProjectBanner.astro";
import ProjectMeta from "../components/ProjectMeta.astro";
import Webmentions from "../components/Webmentions.astro";
import type { Neighbours } from "../lib/prev-next";
import { projectFields } from "../lib/project-fields";
import BaseLayout from "./_BaseLayout.astro";

/**
 * Props for _WorkLayout.
 *
 * Why: typed as CollectionEntry<"works"> so the layout has access to both
 * entry.id (slug) and entry.data (all frontmatter fields).
 * @see packages/specs/plans/03-content-pipeline.md § Task 4
 */
export interface Props {
	entry: CollectionEntry<"works">;
	/**
	 * Prev/next neighbours, computed by the route (it owns the collection query).
	 *
	 * Why: keeps the layout free of `getCollection` so container unit tests that
	 * render it need no content-layer stub.
	 */
	neighbours?: Neighbours<{ id: string; title: string; date: Date }> | undefined;
	/** 1200x630 `og:image` URL built by the route; falls back to the site card when absent. */
	ogImage?: string | undefined;
}

const { entry, neighbours, ogImage } = Astro.props;
const data = projectFields(entry.data);

// Why: secondary external-URL chain mirrors ADR 0011 priority order; kept as the
// meta-row fallback when `links` is empty.
const externalUrl =
	data.type === "code"
		? data.repo
		: data.type === "video"
			? data.youtube
			: data.type === "music"
				? data.listen
				: data.type === "math"
					? (data.arxiv ?? data.pdf)
					: undefined;

const lede = data.lede ?? data.summary;
const description = data.summary ?? data.lede;
const stack = data.stack;
const cover = data.cover;
---

<BaseLayout
	title={data.title}
	{...(description ? { description } : {})}
	{...(ogImage ? { ogImage } : {})}
>
	{/* Why: project pages play a banner loop, so Pause motion lives in the shared site header (D16, P-02). */}
	<MotionToggle slot="controls" />
	<main>
		<article class="h-entry">
			<ProjectBanner slug={entry.id} cover={cover} />
			<div class="work">
				<div class="text">
					<header>
						{/* Why: the wordmark already leads home; the small "← All works" breadcrumb stays under the banner as the way back to the grid. */}
						<div class="nav-row">
							<a href="/" data-test="breadcrumb">
								← All works
							</a>
						</div>
						<h1 class="p-name" tabindex="-1">
							{data.title}
						</h1>
						{lede && <p class="lede p-summary">{lede}</p>}
						<ProjectMeta
							date={data.date}
							started={data.started}
							status={data.status}
							stack={stack}
							links={data.links}
							externalUrl={externalUrl}
						/>
					</header>
					<a class="u-url" href={`/works/${entry.id}/`} aria-hidden="true" hidden></a>
					<div class="e-content">
						<slot />
					</div>
				</div>
				<Gallery items={data.gallery ?? []} />
			</div>
			<div class="col">
				{Astro.slots.has("research") && (
					<section class="research" data-test="research">
						<slot name="research" />
					</section>
				)}
			</div>
			<div class="foot">
				<PrevNext prev={neighbours?.prev ?? null} next={neighbours?.next ?? null} />
			</div>
		</article>
		{/* Why: webmentions are about the article, not part of it — kept outside <article>. */}
		<div class="col">
			<Webmentions slug={entry.id} />
		</div>
	</main>
</BaseLayout>

<style>
	main {
		width: var(--page-width);
		margin-inline: auto;
		padding-block: 0 var(--space-8);
		/* v21: body copy in --color-text-body (#444), headings in --color-text. */
		color: var(--color-text-body);
	}

	.col {
		max-width: 80ch;
	}

	/* P-03: one column below 1200 px (gallery full width under the text); from
	 * 1200 px text left (≈38rem), gallery as a single stack of large figures right. */
	.text {
		max-width: 80ch;
	}
	.work :global(.gallery) {
		margin-block: var(--space-6) 0;
	}
	@media (min-width: 1200px) {
		.work {
			display: grid;
			grid-template-columns: minmax(0, 38rem) minmax(0, 1fr);
			column-gap: var(--space-7);
			align-items: start;
		}
		.text {
			max-width: 38rem;
		}
		.work :global(.gallery) {
			margin-block: var(--space-2) 0;
		}
	}
	.e-content :global(p),
	.e-content :global(li) {
		max-width: 65ch;
		text-wrap: pretty;
	}
	/* Why: breadcrumb and Pause-motion share a wrapping row with a real gap
	 * (they used to touch); the title sits below. */
	.nav-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	header {
		margin-block-end: var(--space-4);
	}

	h1 {
		/* v21: headings are Geist 600, tight tracking (ADR 0042). */
		font-family: var(--font-sans);
		font-size: var(--font-size-7);
		font-weight: 600;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-block: var(--space-2) 0;
	}
	h1:focus {
		outline: none;
	}

	.lede {
		margin: var(--space-3) 0 0;
		max-width: 65ch;
		font-size: var(--font-size-5);
		line-height: var(--leading-snug);
		text-wrap: pretty;
		color: var(--color-text);
	}

	.research {
		margin-block: var(--space-6);
	}
</style>
