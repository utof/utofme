---
/**
 * _BaseLayout.astro — shared shell for all pages.
 *
 * Why: centralises <head> boilerplate (charset, viewport, title, token import,
 * font CSS variables) so individual pages do not repeat it. Leading underscore
 * signals "layout, not a routable page" — consistent with Astro convention.
 * The <Font> component is required to inject @font-face rules + preload <link>
 * tags for each font registered in astro.config.mjs under `fonts:`. Without it
 * the Fonts API does not emit any CSS — the CSS variable only contains the
 * fallback value from tokens.css.
 * See: packages/specs/plans/00-foundations.md § Task 8
 * See: https://docs.astro.build/en/guides/fonts/ (Font component usage)
 * See: https://github.com/withastro/docs/blob/main/src/content/docs/en/reference/modules/astro-assets.mdx
 */

import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.svelte";
import LinkPreview from "../components/LinkPreview.svelte";
import SlashFooter from "../components/SlashFooter.astro";
import previews from "../data/note-previews.json";

interface Props {
	/** Document <title> content. */
	title: string;
	/** Optional meta description for the page (defaults to a phase-appropriate placeholder). */
	description?: string;
}

const { title, description = "utofme — personal site and portfolio." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Why: an empty inline favicon prevents the spurious /favicon.ico 404 +
		     console error that Lighthouse counts under `errors-in-console` (a
		     best-practices audit also factored into Performance via Speed Index
		     filmstrip variance). The site's real favicon ships in a later phase. -->
		<link
			rel="icon"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'/%3E"
		/>
		<!-- Why: meta-description is a SEO + best-practices audit; an empty page
		     fails the `meta-description` audit and is flagged in Lighthouse SEO. -->
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- Astro Fonts API: emits @font-face CSS + optional preload <link> for each
		     registered font family. We preload ONLY the mono face — both variable
		     Google fonts use `display: "optional"` (see astro.config.mjs); preloading
		     three fonts triples connection contention without improving Speed Index
		     because optional won't swap on Slow-4G (Lighthouse mobile throttling)
		     within its 100ms window anyway. Mono is preloaded because it carries the
		     code-block aesthetic the design depends on.
		     See: packages/specs/specs/00-foundations.md § "Success criteria" (Lighthouse mobile ≥ 95)
		     See: https://docs.astro.build/en/guides/fonts/ -->
		<Font cssVariable="--font-serif" />
		<Font cssVariable="--font-sans" />
		<Font cssVariable="--font-mono" preload />
		<!-- Why: ClientRouter enables site-wide SPA navigation (view transitions).
		     transition:persist on CommandPalette retains the Svelte island across
		     route swaps. Verified API: import { ClientRouter } from "astro:transitions".
		     See: https://docs.astro.build/en/guides/view-transitions/
		     @see packages/specs/plans/02-interactivity.md § Task 12 -->
		<ClientRouter />
	</head>
	<body>
		<slot />
		<SlashFooter />
		<!-- Why: CommandPalette mounted here (not per-page) so it is available on
		     every route without re-mounting. transition:persist retains the Svelte
		     island (DOM + state) across Astro ClientRouter SPA navigations once
		     Task 12 wires <ClientRouter />. Bare transition:persist is correct here:
		     the named-value form pairs two *different* DOM elements across pages,
		     but this element lives at the same position in _BaseLayout on every
		     route, so bare form suffices.
		     See: https://docs.astro.build/en/guides/view-transitions/#maintaining-state
		     @see packages/specs/plans/02-interactivity.md § Task 10 -->
		<CommandPalette client:idle transition:persist />
		<!-- Why: inline note-preview index so the LinkPreview island can read it
		     synchronously (no fetch). The </script escape prevents an
		     attacker-controlled summary/title from prematurely closing the
		     <script> block. The build pipeline (Task 7) regenerates this JSON on
		     every astro build via prebuild:garden.
		     @see packages/specs/plans/05-garden.md § Task 10 -->
		<script
			type="application/json"
			id="note-previews"
			set:html={JSON.stringify(previews).replace(/<\/script/g, "<\\/script")}
		/>
		<!-- Why: Obsidian-style hover preview for wikilinks. client:idle so
		     hydration does not block first paint. Delegated body-level
		     mouseover/focusin keeps per-link cost flat as the garden grows.
		     @see packages/specs/plans/05-garden.md § Task 10 -->
		<LinkPreview client:idle />
	</body>
</html>

<style is:global>
	/* Import design tokens globally so every page / component can use var(--space-*) etc. */
	@import "../styles/tokens.css";

	/* Import stagger animation for grid cards (Task 12: ClientRouter + transitions). */
	@import "../styles/transitions.css";

	/* Apply font variables from the Astro Fonts API to the document root.
	 * Why: the API injects --font-serif / --font-sans / --font-mono as CSS custom
	 * properties (populated by the generated @font-face blocks + <Font> component);
	 * applying them here to html/body ensures the cascade reaches every element
	 * without per-component repetition.
	 * See: packages/specs/plans/00-foundations.md § Task 8 "Wire tokens.css" */
	html {
		font-family: var(--font-sans);
		font-size: var(--font-size-3);
		background-color: var(--color-bg);
		color: var(--color-text);
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
	}
</style>
