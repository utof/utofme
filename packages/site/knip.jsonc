{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// entry + project use explicit unit/e2e sub-dirs (not tests/**) so that
	// Task 4's tests/fixtures/check-docs/ lives outside knip's view — that
	// fixture exports a deliberately-undocumented `foo()` that would otherwise
	// be flagged as an unused export and break the Task 4 GREEN gate.
	// Why: see packages/specs/plans/00-foundations.md § Task 4 RED.
	//
	// scripts/**/*.ts is added to entry + project so that knip can trace
	// imports within CLI scripts (e.g. scripts/check-docs.ts imports ts-morph)
	// and correctly classify ts-morph as a used dependency.
	// Why: CLI scripts are stand-alone entry points invoked via `bun run check:docs`;
	// they are not reachable from src/pages/** so must be declared explicitly.
	"entry": ["src/pages/**/*.{astro,ts,js}", "tests/{unit,e2e}/**/*.ts", "scripts/**/*.ts"],
	"project": ["src/**/*.{ts,tsx,astro,svelte}", "tests/{unit,e2e}/**/*.ts", "scripts/**/*.ts"],
	// Why: ignoreExportsUsedInFile for interfaces and type aliases lets knip skip
	// exported types that are referenced within the same file (e.g. ListWorksOptions
	// used as the opts parameter type in listWorks; StatsSource / Snapshot used as
	// param/return types in lib/stats.ts). These are public API types for external
	// callers added in Tasks 4 / 6; they have no external consumer yet within this phase.
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	// Why: ignoreFiles was used by Task 8 to suppress _NoteLayout.astro +
	// Backlinks.astro before their consumers existed. Task 9 added
	// src/pages/garden/index.astro + [slug].astro — both files are now
	// consumed and no longer need suppression.
	// See packages/specs/plans/05-garden.md § Task 9
	"ignoreFiles": [],
	"ignoreDependencies": [
		// Why: wrangler is a CLI-only dev dep (no `import` from source). It powers
		// the deploy step (cloudflare/wrangler-action@v3 in deploy.yml) and gives
		// IDE-resolvable schema validation for wrangler.jsonc. Spec § "Pinned dev
		// deps" (line 68) lists it explicitly. Knip can't see CLI usage, so the
		// dep would otherwise be flagged as unused.
		"wrangler",
		// Why: pagefind is invoked at build time by astro-pagefind integration, not
		// imported directly by any source file. The integration calls the pagefind
		// binary via its Node API internally during `astro build`. Knip can't trace
		// this indirect usage, so it flags pagefind as unused. Verified 2026-04-26.
		"pagefind",
		// Why: force-graph is consumed via a dynamic import inside GraphView.svelte
		// (`await import("force-graph")`). Knip cannot trace dynamic imports through
		// the Svelte component's script block in this version, so it still flags the
		// dep as unused. Kept here so `bun run check:knip` stays clean.
		// See: packages/specs/adrs/0026-force-graph-over-sigma.md
		"force-graph"
		// Removed in Phase 5 Task 12 (knip hints fired after Task 11 landed):
		//   lefthook     — knip now detects lefthook.yml usage directly.
		//   katex        — knip now traces the `katex/dist/katex.min.css?url`
		//                  import in src/layouts/_NoteLayout.astro.
		//   @floating-ui/dom — knip now traces import in src/components/LinkPreview.svelte.
		// Why: gray-matter removed from this list in Task 3 (scripts/sync-vault.ts
		// imports it directly). react/react-dom removed after Task 10.
	]
}
